rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(householdId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function validItemFields(data) {
      return data.name is string
        && data.categoryId is string
        && data.priority in ['must', 'nice']
        && data.price is number
        && data.quantity is number
        && data.status in ['needed', 'bought'];
    }

    function immutableFieldsUnchanged() {
      return request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create, delete: if false;
      allow update: if isMember(householdId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currency', 'budget'])
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      match /members/{memberId} {
        allow read: if isMember(householdId);
        allow write: if false;
      }

      match /items/{itemId} {
        allow read: if isMember(householdId);

        allow create: if isMember(householdId)
          && request.resource.data.addedBy == request.auth.uid
          && validItemFields(request.resource.data);

        allow update: if isMember(householdId)
          && validItemFields(request.resource.data)
          && immutableFieldsUnchanged();

        allow delete: if isMember(householdId);
      }

      match /activity/{eventId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.type in ['added', 'edited', 'purchased', 'unpurchased', 'deleted']
          && request.resource.data.itemName is string;
        allow update, delete: if false;
      }
    }
  }
}
